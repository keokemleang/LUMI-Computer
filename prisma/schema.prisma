// LUMI Computer — Computer Parts & Laptops Shop schema
// PostgreSQL (Railway) datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth (credentials, sessions, password reset) is owned entirely by Firebase
// Authentication. This table only holds the app-specific profile — role and
// display info — keyed by email, looked up after verifying the Firebase
// session cookie server-side (see src/lib/session.js).
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String    @default("customer") // customer | admin
  image     String? // avatar URL (Google profile picture, etc.)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home") // Home | Work | Other
  name      String
  phone     String?
  street    String
  city      String
  zip       String?
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?   @db.Text
  icon        String?
  image       String?
  featured    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  brand        String?
  shortDesc    String   @db.Text
  description  String   @db.Text
  price        Float
  compareAt    Float?
  sku          String
  stock        Int      @default(0)
  images       String   @db.Text // JSON array of URLs
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  specs        String   @db.Text // JSON array of {label,value}
  datasheetUrl String?
  featured     Boolean  @default(false)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())
  reviews      Review[]

  @@index([categoryId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id              String   @id @default(cuid())
  orderNo         String   @unique
  userEmail       String
  userName        String
  total           Float
  status          String   @default("processing") // processing | shipped | delivered | cancelled
  items           String   @db.Text // JSON array
  shippingAddress String?  @db.Text // JSON: {name, phone, street, city, zip, country}
  paymentMethod   String   @default("khqr")
  paymentStatus   String   @default("pending") // pending | paid | expired | failed
  paymentRef      String?  @unique // reference sent to the KHQR provider
  createdAt       DateTime @default(now())

  @@index([userEmail])
  @@index([status])
  @@index([paymentStatus])
}

model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

// Singleton row (id is always "default") — admin-configurable store settings.
model Settings {
  id                    String   @id @default("default")
  storeName             String   @default("LUMI Computer")
  supportEmail          String   @default("support@lumicomputer.com")
  currency              String   @default("usd")
  timezone              String   @default("utc-8")
  flatShippingRate      Float    @default(5.99)
  freeShippingThreshold Float    @default(50)
  enableFreeShipping    Boolean  @default(true)
  internationalShipping Boolean  @default(false)
  notifyNewOrder        Boolean  @default(true)
  notifyNewsletter      Boolean  @default(true)
  notifyMarketing       Boolean  @default(true)
  heroImage1            String   @default("https://picsum.photos/seed/hero-gpu/600/600")
  heroImage2            String   @default("https://picsum.photos/seed/hero-laptop/600/600")
  updatedAt             DateTime @updatedAt
}
